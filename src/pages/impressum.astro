---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title="Impressum" noindex>
  <div class="wrap">
    <section class="page-head rise"><h1>Impressum</h1></section>
    <div class="prose rise" style="padding-top: 0; --d: 100ms" lang="de">
      <!-- TODO: fill in and have it checked. Required details under § 5 DDG. A summonable
           address is required; a business/c-o address service is an option, but whether it
           suffices is contested — check before relying on one. -->
      <h2 id="angaben">Angaben gemäß § 5 DDG</h2>
      <p>{site.name}<br />[Straße und Hausnummer]<br />[PLZ Ort]<br />Deutschland</p>
      <h2 id="kontakt">Kontakt</h2>
      <p>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <h2 id="verantwortlich">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{site.name}, Anschrift wie oben</p>
    </div>
  </div>
</Base>
