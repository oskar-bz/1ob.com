---
interface Props { url: string; title: string; hn?: string }
const { url, title, hn } = Astro.props;
const x = `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
// Discussion exists → open it; otherwise HN's submit form, pre-filled.
const hnHref = hn
  ? `https://news.ycombinator.com/item?id=${hn}`
  : `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}`;
const arrow = '<svg viewBox="0 0 8 8" aria-hidden="true"><path d="M1.5 6.5L6.5 1.5M2.5 1.5h4v4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>';
---
<div class="share">
  <span class="lbl">Share</span>
  <div class="row">
    <button class="nl" type="button" data-copy={url}><span class="swap"><span>Copy link</span><span aria-hidden="true">Copied</span></span></button>
    <a class="nl" href={x} rel="noopener" target="_blank">Share on X<Fragment set:html={arrow} /></a>
    <a class="nl" href={hnHref} rel="noopener" target="_blank" style="--c: var(--orange)">Discuss on HN<Fragment set:html={arrow} /></a>
  </div>
</div>
