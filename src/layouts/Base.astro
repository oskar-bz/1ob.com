---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
// The latin subsets every page uses; preloaded so they are ready by first paint instead of
// being discovered only after the stylesheet has been parsed.
import serifFont from '@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url';
import sansFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  status?: number;
}
const { title, description = site.description, type = 'website', noindex = false, status } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en" data-status={status}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#f4f2ec" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? site.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.domain} />
  <meta name="twitter:card" content="summary" />
  {[serifFont, sansFont, monoFont].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  <!-- View-transition opt-in, inline rather than in global.css: Chrome reads it when the parser
       reaches <body>, and an external stylesheet still loading at that point (cold cache,
       DevTools "Disable cache") makes the incoming page abort the transition with
       "InvalidStateError: ViewTransition opt-in disabled". -->
  <style is:inline>@view-transition { navigation: auto; }</style>
  <!-- Entry animation only on the first page of a visit. Decided from the referrer,
       so nothing is stored on the visitor's device (§ 25 TDDDG). -->
  <script is:inline>
    (function () {
      var html = document.documentElement;
      try {
        var r = document.referrer;
        if (!r || r.indexOf(location.origin) !== 0) html.setAttribute('data-entry', '');
      } catch (e) {}

      // Cross-document view transitions. Every site page opts in via CSS; here we
      // (1) skip them under reduced motion and for targets that aren't site pages,
      // (2) catch the transition's promises so a skipped/aborted one never surfaces as an error,
      // (3) mark the incoming page so its content can rise in behind the morphing title.
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var quiet = function (vt) {
        if (!vt) return;
        ['ready', 'finished', 'updateCallbackDone'].forEach(function (k) { vt[k] && vt[k].catch(function () {}); });
      };
      addEventListener('pageswap', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        quiet(vt);
        var to = e.activation && e.activation.entry && e.activation.entry.url;
        var path = to ? new URL(to).pathname : '';
        if (reduce || /^\/(analytics|api|data)\/|\.(xml|json|php)$/.test(path)) vt.skipTransition();
      });
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        quiet(vt);
        if (reduce) { vt.skipTransition(); return; }
        html.setAttribute('data-vt', '');
        vt.finished.finally(function () { setTimeout(function () { html.removeAttribute('data-vt'); }, 700); });
      });
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet">
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </div>
  <div class="under">
    <div class="wrap">
      <a href="#" class="wmr" aria-label={`${site.domain}, back to top`}>1ob<span>/</span></a>
    </div>
  </div>

  <script>
    // Copy buttons: <button data-copy="text"> with a .swap label inside.
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      let t: number | undefined;
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(btn.dataset.copy || location.href); } catch { return; }
        const s = btn.querySelector('.swap');
        s?.classList.add('on');
        clearTimeout(t);
        t = window.setTimeout(() => s?.classList.remove('on'), 1600);
      });
    });

    // Keyboard shortcuts: g then h / p / w / a.
    const go: Record<string, string> = { h: '/', p: '/projects/', w: '/writing/', a: '/about/' };
    let armed = 0;
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
      const el = e.target as HTMLElement;
      if (el.closest('input, textarea, select, [contenteditable="true"]')) return;
      if (e.key === 'g') { armed = Date.now(); return; }
      if (armed && Date.now() - armed < 1000 && go[e.key]) { armed = 0; location.href = go[e.key]; }
    });
  </script>
  <script src="../lib/analytics.ts"></script>
</body>
</html>
