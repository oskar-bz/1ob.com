# 1ob.com — Apache configuration (all-inkl, Apache 2.4)

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS and no www. (If KAS "SSL erzwingen" is enabled, the first condition is redundant but harmless.)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://1ob.com%{REQUEST_URI} [R=301,L]

  # Addresses from the previous site
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^blog\.php$ /writing/ [R=301,L]
  RewriteRule ^projects\.php$ /projects/ [R=301,L]
  RewriteRule ^blog/([A-Za-z0-9_-]+)/?$ /writing/$1/ [R=301,L]
  RewriteRule ^project/([A-Za-z0-9_-]+)/?$ /projects/$1/ [R=301,L]
  RewriteRule ^feed\.xml$ /rss.xml [R=301,L]
</IfModule>

# Never serve dotfiles (except .well-known)
RedirectMatch 404 "/\.(?!well-known)"

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML revalidates every time; hashed build assets are cached forever.
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(woff2|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Everything is first-party. 'unsafe-inline' covers the one inline head script and inline style attributes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
